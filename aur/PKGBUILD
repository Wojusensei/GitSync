pkgname=gitsync
pkgver=0.3.3
pkgrel=1
pkgdesc="交互式 Git 历史浏览器，可视化提交图、分支、差异对比、Blame 等，帮助开发者更直观地理解和管理 Git 仓库"
arch=('x86_64')
url="https://github.com/Wojusensei/GitSync"
license=('MIT')

depends=(
    'gtk3'
    'webkit2gtk-4.1'
)

source=(
    "GitSync"
    "gitsync.desktop"
    "icon.png"
)
# GitSync 二进制由 CI 按 pkgver 构建覆盖，校验和随版本变化，保持 SKIP；
# 其余静态文件使用真实校验和（makepkg -g 生成）
sha256sums=(
    'SKIP'
    '1dadb9cfe8b48082df3936e51f42ad15caab8784d2e54d96e32497bd36d2bf6c'
    '1f3689f6374b0553996fdc99743799216703835070145d7f0e6ec11e6280139e'
)

package() {

    # 主程序
    install -Dm755 \
        "$srcdir/GitSync" \
        "$pkgdir/usr/bin/gitsync"

    # desktop 文件
    install -Dm644 \
        "$srcdir/gitsync.desktop" \
        "$pkgdir/usr/share/applications/gitsync.desktop"

    # 图标
    install -Dm644 \
        "$srcdir/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/gitsync.png"
}